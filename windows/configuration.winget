        "testScript": "$specification = '{\"id\":\"Zen-Team.Zen-Browser\",\"policy\":\"self-updating\",\"scope\":\"machine\",\"source\":\"winget\",\"registrationOnly\":true}' | ConvertFrom-Json\n$ErrorActionPreference = 'Stop'\nfunction Get-InstalledVersion {\n  $output = & winget list --id $specification.id --exact --source winget --scope machine --accept-source-agreements --disable-interactivity 2>&1\n  $code = $LASTEXITCODE\n  if ($code -eq -1978335212 -or $code -eq -1978335189) { return $null }\n  if ($code -ne 0) { throw \"winget failed with exit code $code\" }\n  $pattern = '(?m)' + [regex]::Escape($specification.id) + '\\s+(\\S+)'\n  $match = [regex]::Match(($output -join \"`n\"), $pattern)\n  if (-not $match.Success) { return $null }\n  return $match.Groups[1].Value\n}\nfunction Test-UserUpgradeAvailable {\n  $output = & winget list --id $specification.id --exact --source winget --scope machine --upgrade-available --accept-source-agreements --disable-interactivity 2>&1\n  if ($LASTEXITCODE -eq -1978335212 -or $LASTEXITCODE -eq -1978335189) { return $false }\n  if ($LASTEXITCODE -ne 0) { throw \"winget failed with exit code $LASTEXITCODE\" }\n  return (($output -join \"`n\") -match [regex]::Escape($specification.id))\n}\n$installed = Get-InstalledVersion\nif (-not $installed) { return $false }\nreturn (-not (Test-UserUpgradeAvailable))\n",
        "setScript": "$specification = '{\"id\":\"Zen-Team.Zen-Browser\",\"policy\":\"self-updating\",\"scope\":\"machine\",\"source\":\"winget\",\"registrationOnly\":true}' | ConvertFrom-Json\n$ErrorActionPreference = 'Stop'\nfunction Get-InstalledVersion {\n  $output = & winget list --id $specification.id --exact --source winget --scope machine --accept-source-agreements --disable-interactivity 2>&1\n  $code = $LASTEXITCODE\n  if ($code -eq -1978335212 -or $code -eq -1978335189) { return $null }\n  if ($code -ne 0) { throw \"winget failed with exit code $code\" }\n  $pattern = '(?m)' + [regex]::Escape($specification.id) + '\\s+(\\S+)'\n  $match = [regex]::Match(($output -join \"`n\"), $pattern)\n  if (-not $match.Success) { return $null }\n  return $match.Groups[1].Value\n}\nfunction Test-UserUpgradeAvailable {\n  $output = & winget list --id $specification.id --exact --source winget --scope machine --upgrade-available --accept-source-agreements --disable-interactivity 2>&1\n  if ($LASTEXITCODE -eq -1978335212 -or $LASTEXITCODE -eq -1978335189) { return $false }\n  if ($LASTEXITCODE -ne 0) { throw \"winget failed with exit code $LASTEXITCODE\" }\n  return (($output -join \"`n\") -match [regex]::Escape($specification.id))\n}\n$installed = Get-InstalledVersion\nif ($installed -and -not (Test-UserUpgradeAvailable)) { return }\n& winget install --scope machine --id $specification.id --exact --source winget --architecture x64 --skip-dependencies --silent --accept-package-agreements --accept-source-agreements --disable-interactivity\nif ($LASTEXITCODE -ne 0) { throw \"winget failed with exit code $LASTEXITCODE\" }\n"
