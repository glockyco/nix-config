      "properties": {
        "testScript": "$specification = '{\"id\":\"GitHub.cli\",\"version\":\"2.102.0\",\"url\":\"https://github.com/cli/cli/releases/download/v2.102.0/gh_2.102.0_windows_amd64.zip\",\"sha256\":\"ae64e556ecc240b200f7eba60d550e4bb60d78e860e69dd88c449405b86067f4\",\"directory\":\"Programs\\\\GitHub CLI\",\"executable\":\"bin\\\\gh.exe\",\"payload\":\".\",\"versionArgs\":[\"--version\"]}' | ConvertFrom-Json\n$ErrorActionPreference = 'Stop'\n$destination = Join-Path $env:LOCALAPPDATA $specification.directory\n$executable = Join-Path $destination $specification.executable\nfunction Get-ZipToolVersion {\n  if (-not (Test-Path -LiteralPath $executable)) { return $null }\n  $output = & $executable @($specification.versionArgs)\n  if ($LASTEXITCODE -ne 0) { throw \"Native command failed with exit code $LASTEXITCODE\" }\n  $match = [regex]::Match(($output -join \"`n\"), '(\\d+\\.\\d+\\.\\d+)')\n  if (-not $match.Success) { throw \"${executable}: unrecognized version output\" }\n  return [version]$match.Groups[1].Value\n}\nfunction Add-UserToolPath {\n  $directory = Split-Path -Parent $executable\n  $userPath = [Environment]::GetEnvironmentVariable('Path', 'User')\n  if ($directory -notin @($userPath -split ';')) { [Environment]::SetEnvironmentVariable('Path', (($userPath + ';' + $directory).Trim(';')), 'User') }\n  $env:Path = $directory + ';' + $env:Path\n}\n$installed = Get-ZipToolVersion\nif ((Split-Path -Parent $executable) -notin @([Environment]::GetEnvironmentVariable('Path', 'User') -split ';')) { return $false }\nreturn ($null -ne $installed -and $installed -eq [version]$specification.version)\n",
        "setScript": "$specification = '{\"id\":\"GitHub.cli\",\"version\":\"2.102.0\",\"url\":\"https://github.com/cli/cli/releases/download/v2.102.0/gh_2.102.0_windows_amd64.zip\",\"sha256\":\"ae64e556ecc240b200f7eba60d550e4bb60d78e860e69dd88c449405b86067f4\",\"directory\":\"Programs\\\\GitHub CLI\",\"executable\":\"bin\\\\gh.exe\",\"payload\":\".\",\"versionArgs\":[\"--version\"]}' | ConvertFrom-Json\n$ErrorActionPreference = 'Stop'\n$destination = Join-Path $env:LOCALAPPDATA $specification.directory\n$executable = Join-Path $destination $specification.executable\nfunction Get-ZipToolVersion {\n  if (-not (Test-Path -LiteralPath $executable)) { return $null }\n  $output = & $executable @($specification.versionArgs)\n  if ($LASTEXITCODE -ne 0) { throw \"Native command failed with exit code $LASTEXITCODE\" }\n  $match = [regex]::Match(($output -join \"`n\"), '(\\d+\\.\\d+\\.\\d+)')\n  if (-not $match.Success) { throw \"${executable}: unrecognized version output\" }\n  return [version]$match.Groups[1].Value\n}\nfunction Add-UserToolPath {\n  $directory = Split-Path -Parent $executable\n  $userPath = [Environment]::GetEnvironmentVariable('Path', 'User')\n  if ($directory -notin @($userPath -split ';')) { [Environment]::SetEnvironmentVariable('Path', (($userPath + ';' + $directory).Trim(';')), 'User') }\n  $env:Path = $directory + ';' + $env:Path\n}\n$installed = Get-ZipToolVersion\nif ($null -ne $installed) {\n  if ($installed -gt [version]$specification.version) { throw \"$($specification.id): refusing downgrade of newer $installed\" }\n  if ($installed -eq [version]$specification.version) { Add-UserToolPath; return }\n}\n$temporary = Join-Path $env:TEMP ([guid]::NewGuid().ToString())\n$archive = Join-Path $temporary 'release.zip'\n$expanded = Join-Path $temporary 'expanded'\nNew-Item -ItemType Directory -Path $temporary | Out-Null\ntry {\n  Invoke-WebRequest -Uri $specification.url -OutFile $archive -UseBasicParsing\n  if ((Get-FileHash -LiteralPath $archive -Algorithm SHA256).Hash.ToLowerInvariant() -ne $specification.sha256) { throw \"$($specification.id): ZIP SHA-256 mismatch before extraction\" }\n  Add-Type -AssemblyName System.IO.Compression.FileSystem\n  [IO.Compression.ZipFile]::ExtractToDirectory($archive, $expanded)\n  $payload = if ($specification.payload -eq '.') { $expanded } else { Join-Path $expanded $specification.payload }\n  $candidate = Join-Path $payload $specification.executable\n  if (-not (Test-Path -LiteralPath $candidate)) { throw \"$($specification.id): release executable missing\" }\n  $output = & $candidate @($specification.versionArgs)\n  if ($LASTEXITCODE -ne 0) { throw \"Native command failed with exit code $LASTEXITCODE\" }\n  if (($output -join \"`n\") -notmatch [regex]::Escape($specification.version)) { throw \"$($specification.id): downloaded executable version mismatch\" }\n  $parent = Split-Path -Parent $destination\n  New-Item -ItemType Directory -Path $parent -Force | Out-Null\n  $backup = $destination + '.previous-' + [DateTime]::UtcNow.ToString('yyyyMMddHHmmssfff')\n  if (Test-Path -LiteralPath $destination) { Move-Item -LiteralPath $destination -Destination $backup }\n  try { Move-Item -LiteralPath $payload -Destination $destination }\n  catch {\n    if ((Test-Path -LiteralPath $backup) -and -not (Test-Path -LiteralPath $destination)) { Move-Item -LiteralPath $backup -Destination $destination }\n    throw\n  }\n  Add-UserToolPath\n} finally { Remove-Item -LiteralPath $temporary -Recurse -Force -ErrorAction SilentlyContinue }\n"
      }
    },
