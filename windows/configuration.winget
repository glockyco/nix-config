ms\\\\npm\"}' | ConvertFrom-Json\n$ErrorActionPreference = 'Stop'\n$prefix = Join-Path $env:LOCALAPPDATA $specification.directory\n$binDirectory = Join-Path $prefix 'node_modules\\.bin'\nfunction ConvertFrom-NpmLockJson {\n  param([string]$Text)\n  if ($PSVersionTable.PSVersion.Major -ge 6) { return (ConvertFrom-Json -InputObject $Text -AsHashtable) }\n  Add-Type -AssemblyName System.Web.Extensions\n  $serializer = New-Object System.Web.Script.Serialization.JavaScriptSerializer\n  return $serializer.DeserializeObject($Text)\n}\nfunction Test-NpmTools {\n  $nodeCommand = Get-Command node.exe -ErrorAction SilentlyContinue\n  if (-not $nodeCommand -or -not $nodeCommand.Source.StartsWith($env:LOCALAPPDATA, [StringComparison]::OrdinalIgnoreCase)) { return $false }\n  if ($binDirectory -notin @([Environment]::GetEnvironmentVariable('Path', 'User') -split ';')) { return $false }\n  $lockPath = Join-Path $prefix 'package-lock.json'\n  if (-not (Test-Path -LiteralPath $lockPath)) { return $false }\n  $lock = ConvertFrom-NpmLockJson (Get-Content -LiteralPath $lockPath -Raw)\n  foreach ($property in $specification.packages.PSObject.Properties) {\n    $name = $property.Name; $selected = $property.Value\n    $actual = $lock.packages['node_modules/' + $name]\n    if ($actual.version -ne $selected.version -or $actual.integrity -ne $selected.integrity) { return $false }\n    $manifestPath = Join-Path $prefix ('node_modules\\' + $name + '\\package.json')\n    if (-not (Test-Path -LiteralPath $manifestPath)) { return $false }\n    $manifest = Get-Content -LiteralPath $manifestPath -Raw | ConvertFrom-Json\n    if ($manifest.version -ne $selected.version) { return $false }\n    foreach ($command in $selected.bin.PSObject.Properties.Name) {\n      if (-not (Test-Path -LiteralPath (Join-Path $binDirectory ($command + '.cmd')))) { return $false }\n    }\n  }\n  foreach ($command in @('pyright','tsc','typescript-language-server','svelteserver','openspec')) {\n    $output = & (Join-Path $binDirectory ($command + '.cmd')) --version\n    if ($LASTEXITCODE -ne 0) { throw \"Native command failed with exit code $LASTEXITCODE\" }\n    $packageName = switch ($command) {\n      'pyright' { 'pyright' }\n      'tsc' { 'typescript' }\n      'typescript-language-server' { 'typescript-language-server' }\n      'svelteserver' { 'svelte-language-server' }\n      'openspec' { '@fission-ai/openspec' }\n    }\n    $expected = $specification.packages.PSObject.Properties[$packageName].Value.version\n    if (($output -join \"`n\") -notmatch [regex]::Escape($expected)) { return $false }\n\n  }\n  return $true\n}\nreturn (Test-NpmTools)\n",
