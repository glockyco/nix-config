      "properties": {
        "testScript": "$specification = '{\"id\":\"Tailscale.Tailscale\",\"version\":\"1.102.4\",\"policy\":\"exact\",\"scope\":\"machine\",\"source\":\"winget\",\"registrationOnly\":true}' | ConvertFrom-Json\n$ErrorActionPreference = 'Stop'\nfunction Get-InstalledVersion {\n  $output = & winget list --id $specification.id --exact --source winget --scope machine --accept-source-agreements --disable-interactivity 2>&1\n  $code = $LASTEXITCODE\n  if ($code -eq -1978335212 -or $code -eq -1978335189) { return $null }\n  if ($code -ne 0) { throw \"winget failed with exit code $code\" }\n  $pattern = '(?m)' + [regex]::Escape($specification.id) + '\\s+(\\S+)'\n  $match = [regex]::Match(($output -join \"`n\"), $pattern)\n  if (-not $match.Success) { return $null }\n  return $match.Groups[1].Value\n}\nfunction Compare-ToolVersion([string]$Installed, [string]$Selected) {\n  $a = [version]($Installed -replace '[^0-9.].*$', '')\n  $b = [version]($Selected -replace '[^0-9.].*$', '')\n  return $a.CompareTo($b)\n}\n$installed = Get-InstalledVersion\nreturn ($null -ne $installed -and (Compare-ToolVersion $installed $specification.version) -eq 0)\n",
        "setScript": "$specification = '{\"id\":\"Tailscale.Tailscale\",\"version\":\"1.102.4\",\"policy\":\"exact\",\"scope\":\"machine\",\"source\":\"winget\",\"registrationOnly\":true}' | ConvertFrom-Json\n$ErrorActionPreference = 'Stop'\nfunction Get-InstalledVersion {\n  $output = & winget list --id $specification.id --exact --source winget --scope machine --accept-source-agreements --disable-interactivity 2>&1\n  $code = $LASTEXITCODE\n  if ($code -eq -1978335212 -or $code -eq -1978335189) { return $null }\n  if ($code -ne 0) { throw \"winget failed with exit code $code\" }\n  $pattern = '(?m)' + [regex]::Escape($specification.id) + '\\s+(\\S+)'\n  $match = [regex]::Match(($output -join \"`n\"), $pattern)\n  if (-not $match.Success) { return $null }\n  return $match.Groups[1].Value\n}\nfunction Compare-ToolVersion([string]$Installed, [string]$Selected) {\n  $a = [version]($Installed -replace '[^0-9.].*$', '')\n  $b = [version]($Selected -replace '[^0-9.].*$', '')\n  return $a.CompareTo($b)\n}\n$installed = Get-InstalledVersion\nif ($installed) {\n  $comparison = Compare-ToolVersion $installed $specification.version\n  if ($comparison -gt 0) { throw \"Tailscale: refusing downgrade of $installed\" }\n  if ($comparison -eq 0) { return }\n}\n& winget install --scope machine --id $specification.id --exact --source winget --version $specification.version --architecture x64 --installer-type wix --skip-dependencies --silent --accept-package-agreements --accept-source-agreements --disable-interactivity\nif ($LASTEXITCODE -ne 0) { throw \"Native command failed with exit code $LASTEXITCODE\" }\n"
