ng' -and -not (Test-UserUpgradeAvailable)) { return }\n  if ($specification.policy -eq 'exact' -and (Test-Path -LiteralPath (Get-ToolPath))) {\n  $output = & (Get-ToolPath) --version\n  if ($LASTEXITCODE -ne 0) { throw \"Native command failed with exit code $LASTEXITCODE\" }\n  $match = [regex]::Match(($output -join \"`n\"), '(\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?)')\n  if (-not $match.Success) { throw \"$($specification.id): native executable version is unrecognized\" }\n  $installed = $match.Groups[1].Value\n  $comparison = Compare-ToolVersion $installed $specification.version\n  if ($comparison -gt 0) { throw \"$($specification.id): newer $installed installed; refusing downgrade to $($specification.version). Review recovery manually.\" }\n  if ($comparison -eq 0) { return }\n  }\n}\nif ($specification.requiresVCRuntime) {\n  $runtime = Get-ItemProperty 'HKLM:\\SOFTWARE\\Microsoft\\VisualStudio\\14.0\\VC\\Runtimes\\x64' -ErrorAction SilentlyContinue\n  if ($runtime.Installed -ne 1) { throw \"$($specification.id): employer-owned Visual C++ x64 runtime is missing; ask IT, do not install a competing runtime.\" }\n}\n$args = @('install', '--id', $specification.id, '--exact', '--source', 'winget', '--scope', 'user', '--architecture', 'x64', '--silent', '--skip-dependencies', '--accept-package-agreements', '--accept-source-agreements', '--disable-interactivity')\nif ($specification.policy -eq 'exact') { $args += @('--version', $specification.version) }\nif ($specification.installerType) { $args += @('--installer-type', $specification.installerType) }\n& winget @args\nif ($LASTEXITCODE -ne 0) { throw \"Native command failed with exit code $LASTEXITCODE\" }\n# Portable Node's WinGet alias is node only. npm must use that same real ZIP directory.\nif ($specification.id -eq 'OpenJS.NodeJS.LTS') {\n  $node = Get-Item -LiteralPath (Get-ToolPath)\n  $realNode = if ($node.Target) { [string]$node.Target } else { $node.FullName }\n  $directory = Split-Path -Parent $realNode\n  if (-not (Test-Path -LiteralPath (Join-Path $directory 'npm.cmd'))) { throw 'Node user ZIP has no native npm.cmd alongside node.exe' }\n  $userPath = [Environment]::GetEnvironmentVariable('Path', 'User')\n  if ($directory -notin @($userPath -split ';')) { [Environment]::SetEnvironmentVariable('Path', ($userPath.TrimEnd(';') + ';' + $directory), 'User') }\n  $env:Path = $directory + ';' + $env:Path\n}\n"
