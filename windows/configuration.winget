    {
      "metadata": {
        "description": "Apply Windows dark modes, disable transparency, and select the Bloom wallpaper"
      },
      "name": "windows dark appearance",
      "properties": {
        "setScript": "$personalizePath = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize'\n$wallpaper = Join-Path $env:WINDIR 'Web\\Wallpaper\\Windows\\img19.jpg'\nNew-Item -Path $personalizePath -Force | Out-Null\nNew-ItemProperty -Path $personalizePath -Name AppsUseLightTheme -Value 0 -PropertyType DWord -Force | Out-Null\nNew-ItemProperty -Path $personalizePath -Name SystemUsesLightTheme -Value 0 -PropertyType DWord -Force | Out-Null\nNew-ItemProperty -Path $personalizePath -Name EnableTransparency -Value 0 -PropertyType DWord -Force | Out-Null\n$native = Add-Type -Namespace WindowsConfiguration -Name AppearanceApi -MemberDefinition @'\n  [System.Runtime.InteropServices.DllImport(\"user32.dll\", CharSet = System.Runtime.InteropServices.CharSet.Unicode, SetLastError = true)]\n  public static extern bool SystemParametersInfo(uint action, uint parameter, string value, uint flags);\n  [System.Runtime.InteropServices.DllImport(\"user32.dll\", CharSet = System.Runtime.InteropServices.CharSet.Unicode, SetLastError = true)]\n  public static extern System.IntPtr SendMessageTimeout(System.IntPtr window, uint message, System.UIntPtr wParam, string lParam, uint flags, uint timeout, out System.UIntPtr result);\n'@ -PassThru\nif (-not $native::SystemParametersInfo(20, 0, $wallpaper, 3)) { throw 'Could not apply the Windows dark wallpaper' }\n$broadcastResult = [UIntPtr]::Zero\n[void]$native::SendMessageTimeout([IntPtr]0xffff, 0x001a, [UIntPtr]::Zero, 'ImmersiveColorSet', 0x0002, 5000, [ref]$broadcastResult)\n",
        "testScript": "$personalize = Get-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize' -ErrorAction SilentlyContinue\n$desktop = Get-ItemProperty -Path 'HKCU:\\Control Panel\\Desktop' -ErrorAction SilentlyContinue\n$wallpaper = Join-Path $env:WINDIR 'Web\\Wallpaper\\Windows\\img19.jpg'\nreturn $personalize.AppsUseLightTheme -eq 0 `\n  -and $personalize.SystemUsesLightTheme -eq 0 `\n  -and $personalize.EnableTransparency -eq 0 `\n  -and $desktop.WallPaper -ieq $wallpaper\n"
      },
      "type": "Microsoft.DSC.Transitional/WindowsPowerShellScript"
    },
    {
      "metadata": {
        "description": "Disable Windows animation effects through the supported accessibility API"
      },
      "name": "windows animation effects",
      "properties": {
        "setScript": "$native = Add-Type -Namespace WindowsConfiguration -Name AnimationWriteApi -MemberDefinition @'\n  [System.Runtime.InteropServices.DllImport(\"user32.dll\", EntryPoint = \"SystemParametersInfoW\", SetLastError = true)]\n  [return: System.Runtime.InteropServices.MarshalAs(System.Runtime.InteropServices.UnmanagedType.Bool)]\n  public static extern bool SetClientAreaAnimation(uint action, uint parameter, ref bool value, uint flags);\n'@ -PassThru\n$enabled = $false\nif (-not $native::SetClientAreaAnimation(0x1043, 0, [ref]$enabled, 3)) {\n  throw 'Could not disable Windows animation effects'\n}\n",
        "testScript": "$native = Add-Type -Namespace WindowsConfiguration -Name AnimationReadApi -MemberDefinition @'\n  [System.Runtime.InteropServices.DllImport(\"user32.dll\", EntryPoint = \"SystemParametersInfoW\", SetLastError = true)]\n  [return: System.Runtime.InteropServices.MarshalAs(System.Runtime.InteropServices.UnmanagedType.Bool)]\n  public static extern bool GetClientAreaAnimation(uint action, uint parameter, ref bool value, uint flags);\n'@ -PassThru\n$enabled = $true\nif (-not $native::GetClientAreaAnimation(0x1042, 0, [ref]$enabled, 0)) {\n  throw 'Could not read the Windows animation-effects setting'\n}\nreturn -not $enabled\n"
      },
      "type": "Microsoft.DSC.Transitional/WindowsPowerShellScript"
    },
    {
      "metadata": {
        "description": "Keep the taskbar visible while preserving the rest of its binary settings"
      },
      "name": "taskbar visible",
      "properties": {
        "setScript": "$path = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\StuckRects3'\n$bytes = (Get-ItemProperty -Path $path -Name Settings).Settings\n$bytes[8] = 2\nSet-ItemProperty -Path $path -Name Settings -Value $bytes\nStop-Process -Name explorer -Force\n",
        "testScript": "$path = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\StuckRects3'\n$bytes = (Get-ItemProperty -Path $path -Name Settings).Settings\nreturn ($bytes[8] -eq 2)\n"
      },
      "type": "Microsoft.DSC.Transitional/WindowsPowerShellScript"
    },
    {
      "metadata": {
        "application": {
          "id": "AltSnap.AltSnap",
          "roles": [
            "window-tool"
          ],
          "scope": "user",
          "source": "github-release",
          "version": "1.68",
          "versionPolicy": "exact"
        },
        "description": "Install portable AltSnap binaries; chezmoi owns user INI settings"
      },
      "name": "package window tool",
      "properties": {
        "setScript": "$package = '{\"archiveSha256\":\"7db3dad3746e7b23857db92fc05ee2d3e17eee1b28e237709a612366ba909c79\",\"executableSha256\":\"dba17fbfc2633aac31f5faedb992f4f24ddee3092bb4c803d2b8db83d58255b9\",\"hooksSha256\":\"fa2ff5c2f76267ab6a1d80e432649da023b94e2183fe2f8c27f254f1b0637ed7\",\"url\":\"https://github.com/RamonUnch/AltSnap/releases/download/1.68/AltSnap1.68bin_x64.zip\",\"version\":\"1.68\"}' | ConvertFrom-Json\n$root = Join-Path $env:APPDATA 'AltSnap'\n$installedExecutable = Join-Path $root 'AltSnap.exe'\nif (Test-Path -LiteralPath $installedExecutable) {\n  $installedVersion = (Get-Item -LiteralPath $installedExecutable).VersionInfo.ProductVersion\n  $versionMatch = [regex]::Match([string]$installedVersion, '(\\d+\\.\\d+(?:\\.\\d+)?)')\n  if (-not $versionMatch.Success) { throw 'AltSnap: cannot establish installed version; review recovery before overwriting' }\n  if ([version]$versionMatch.Groups[1].Value -gt [version]$package.version) { throw 'AltSnap: refusing downgrade of newer installed executable' }\n}\n$archive = Join-Path $env:TEMP \"AltSnap-$($package.version).zip\"\n$expanded = Join-Path $env:TEMP \"AltSnap-$($package.version)\"\nGet-Process -Name AltSnap -ErrorAction SilentlyContinue | Stop-Process\ntry {\n  Invoke-WebRequest -Uri $package.url -OutFile $archive -UseBasicParsing\n  if ((Get-FileHash -LiteralPath $archive -Algorithm SHA256).Hash.ToLowerInvariant() -ne $package.archiveSha256) { throw 'AltSnap archive checksum mismatch' }\n  Remove-Item -LiteralPath $expanded -Recurse -Force -ErrorAction SilentlyContinue\n  Add-Type -AssemblyName System.IO.Compression.FileSystem\n  [IO.Compression.ZipFile]::ExtractToDirectory($archive, $expanded)\n  if ((Get-FileHash -LiteralPath (Join-Path $expanded 'AltSnap.exe') -Algorithm SHA256).Hash.ToLowerInvariant() -ne $package.executableSha256) { throw 'AltSnap executable checksum mismatch' }\n  if ((Get-FileHash -LiteralPath (Join-Path $expanded 'hooks.dll') -Algorithm SHA256).Hash.ToLowerInvariant() -ne $package.hooksSha256) { throw 'AltSnap hooks checksum mismatch' }\n  New-Item -ItemType Directory -Path $root -Force | Out-Null\n  Get-ChildItem -LiteralPath $expanded -Force | Where-Object Name -ne 'AltSnap.ini' | Copy-Item -Destination $root -Recurse -Force\n} finally {\n  Remove-Item -LiteralPath $archive -Force -ErrorAction SilentlyContinue\n  Remove-Item -LiteralPath $expanded -Recurse -Force -ErrorAction SilentlyContinue\n}\nStart-Process (Join-Path $root 'AltSnap.exe')\n",
        "testScript": "$package = '{\"archiveSha256\":\"7db3dad3746e7b23857db92fc05ee2d3e17eee1b28e237709a612366ba909c79\",\"executableSha256\":\"dba17fbfc2633aac31f5faedb992f4f24ddee3092bb4c803d2b8db83d58255b9\",\"hooksSha256\":\"fa2ff5c2f76267ab6a1d80e432649da023b94e2183fe2f8c27f254f1b0637ed7\",\"url\":\"https://github.com/RamonUnch/AltSnap/releases/download/1.68/AltSnap1.68bin_x64.zip\",\"version\":\"1.68\"}' | ConvertFrom-Json\n$root = Join-Path $env:APPDATA 'AltSnap'\n$executable = Join-Path $root 'AltSnap.exe'\n$hooks = Join-Path $root 'hooks.dll'\nif (-not (Test-Path -LiteralPath $executable) -or (Get-FileHash -LiteralPath $executable -Algorithm SHA256).Hash.ToLowerInvariant() -ne $package.executableSha256) { return $false }\nif (-not (Test-Path -LiteralPath $hooks) -or (Get-FileHash -LiteralPath $hooks -Algorithm SHA256).Hash.ToLowerInvariant() -ne $package.hooksSha256) { return $false }\nreturn $true\n"
      },
      "type": "Microsoft.DSC.Transitional/WindowsPowerShellScript"
    },
    {
      "name": "package native git",
      "type": "Microsoft.DSC.Transitional/WindowsPowerShellScript",
      "metadata": {
        "description": "Explicit per-user native Git.Git",
        "application": {
          "id": "Git.Git",
          "source": "winget",
          "scope": "user",
          "roles": [
            "native-git"
          ],
          "versionPolicy": "self-updating"
        },
        "distribution": {
          "url": "https://github.com/git-for-windows/git/releases/download/v2.55.0.windows.5/Git-2.55.0.5-64-bit.exe",
          "sha256": "d065a4e23c3d9a6b5073d609b5be0830227ec3ca053c083ba385061ddfaf94c6",
          "manifest": "https://raw.githubusercontent.com/microsoft/winget-pkgs/master/manifests/g/Git/Git/2.55.0.5/Git.Git.installer.yaml",
          "installerType": "inno",
          "observationOnly": true,
          "observedVersion": "2.55.0.5"
        }
      },
      "properties": {
        "testScript": "$specification = '{\"id\":\"Git.Git\",\"policy\":\"self-updating\",\"scope\":\"user\",\"source\":\"winget\",\"executable\":\"git.exe\",\"installerType\":null,\"requiresVCRuntime\":false}' | ConvertFrom-Json\n$ErrorActionPreference = 'Stop'\nfunction Get-InstalledVersion {\n  $output = & winget list --id $specification.id --exact --source winget --scope user --accept-source-agreements --disable-interactivity 2>&1\n  $code = $LASTEXITCODE\n  if ($code -eq -1978335212 -or $code -eq -1978335189) { return $null }\n  if ($code -ne 0) { throw \"winget failed with exit code $code\" }\n  $pattern = '(?m)' + [regex]::Escape($specification.id) + '\\s+(\\S+)'\n  $match = [regex]::Match(($output -join \"`n\"), $pattern)\n  if (-not $match.Success) { return $null }\n  return $match.Groups[1].Value\n}\nfunction Test-UserUpgradeAvailable {\n  $output = & winget list --id $specification.id --exact --source winget --scope user --upgrade-available --accept-source-agreements --disable-interactivity 2>&1\n  if ($LASTEXITCODE -eq -1978335212 -or $LASTEXITCODE -eq -1978335189) { return $false }\n  if ($LASTEXITCODE -ne 0) { throw \"Native command failed with exit code $LASTEXITCODE\" }\n  return (($output -join \"`n\") -match [regex]::Escape($specification.id))\n}\nfunction Compare-ToolVersion([string]$Installed, [string]$Selected) {\n  $a = [version]($Installed -replace '[^0-9.].*$', '')\n  $b = [version]($Selected -replace '[^0-9.].*$', '')\n  return $a.CompareTo($b)\n}\nfunction Get-ToolPath {\n  if ($specification.id -eq 'Git.Git') { return (Join-Path $env:LOCALAPPDATA 'Programs\\Git\\cmd\\git.exe') }\n  if ($specification.id -eq 'Python.Python.3.13') { return (Join-Path $env:LOCALAPPDATA 'Programs\\Python\\Python313\\python.exe') }\n  return (Join-Path $env:LOCALAPPDATA ('Microsoft\\WinGet\\Links\\' + $specification.executable))\n}\n$installed = Get-InstalledVersion\nif (-not $installed) { return $false }\n$tool = Get-ToolPath\nif (-not (Test-Path -LiteralPath $tool)) { return $false }\n$versionOutput = & $tool --version\nif ($LASTEXITCODE -ne 0) { throw \"Native command failed with exit code $LASTEXITCODE\" }\nif ($specification.policy -eq 'self-updating') { return (-not (Test-UserUpgradeAvailable)) }\n$output = & (Get-ToolPath) --version\n  if ($LASTEXITCODE -ne 0) { throw \"Native command failed with exit code $LASTEXITCODE\" }\n  $match = [regex]::Match(($output -join \"`n\"), '(\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?)')\n  if (-not $match.Success) { throw \"$($specification.id): native executable version is unrecognized\" }\n  $installed = $match.Groups[1].Value\nreturn ((Compare-ToolVersion $installed $specification.version) -eq 0)\n",
        "setScript": "$specification = '{\"id\":\"Git.Git\",\"policy\":\"self-updating\",\"scope\":\"user\",\"source\":\"winget\",\"executable\":\"git.exe\",\"installerType\":null,\"requiresVCRuntime\":false}' | ConvertFrom-Json\n$ErrorActionPreference = 'Stop'\nfunction Get-InstalledVersion {\n  $output = & winget list --id $specification.id --exact --source winget --scope user --accept-source-agreements --disable-interactivity 2>&1\n  $code = $LASTEXITCODE\n  if ($code -eq -1978335212 -or $code -eq -1978335189) { return $null }\n  if ($code -ne 0) { throw \"winget failed with exit code $code\" }\n  $pattern = '(?m)' + [regex]::Escape($specification.id) + '\\s+(\\S+)'\n  $match = [regex]::Match(($output -join \"`n\"), $pattern)\n  if (-not $match.Success) { return $null }\n  return $match.Groups[1].Value\n}\nfunction Test-UserUpgradeAvailable {\n  $output = & winget list --id $specification.id --exact --source winget --scope user --upgrade-available --accept-source-agreements --disable-interactivity 2>&1\n  if ($LASTEXITCODE -eq -1978335212 -or $LASTEXITCODE -eq -1978335189) { return $false }\n  if ($LASTEXITCODE -ne 0) { throw \"Native command failed with exit code $LASTEXITCODE\" }\n  return (($output -join \"`n\") -match [regex]::Escape($specification.id))\n}\nfunction Compare-ToolVersion([string]$Installed, [string]$Selected) {\n  $a = [version]($Installed -replace '[^0-9.].*$', '')\n  $b = [version]($Selected -replace '[^0-9.].*$', '')\n  return $a.CompareTo($b)\n}\nfunction Get-ToolPath {\n  if ($specification.id -eq 'Git.Git') { return (Join-Path $env:LOCALAPPDATA 'Programs\\Git\\cmd\\git.exe') }\n  if ($specification.id -eq 'Python.Python.3.13') { return (Join-Path $env:LOCALAPPDATA 'Programs\\Python\\Python313\\python.exe') }\n  return (Join-Path $env:LOCALAPPDATA ('Microsoft\\WinGet\\Links\\' + $specification.executable))\n}\n$installed = Get-InstalledVersion\nif ($installed) {\n  if ($specification.policy -eq 'self-updating' -and -not (Test-UserUpgradeAvailable)) { return }\n  if ($specification.policy -eq 'exact' -and (Test-Path -LiteralPath (Get-ToolPath))) {\n  $output = & (Get-ToolPath) --version\n  if ($LASTEXITCODE -ne 0) { throw \"Native command failed with exit code $LASTEXITCODE\" }\n  $match = [regex]::Match(($output -join \"`n\"), '(\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?)')\n  if (-not $match.Success) { throw \"$($specification.id): native executable version is unrecognized\" }\n  $installed = $match.Groups[1].Value\n  $comparison = Compare-ToolVersion $installed $specification.version\n  if ($comparison -gt 0) { throw \"$($specification.id): newer $installed installed; refusing downgrade to $($specification.version). Review recovery manually.\" }\n  if ($comparison -eq 0) { return }\n  }\n}\nif ($specification.requiresVCRuntime) {\n  $runtime = Get-ItemProperty 'HKLM:\\SOFTWARE\\Microsoft\\VisualStudio\\14.0\\VC\\Runtimes\\x64' -ErrorAction SilentlyContinue\n  if ($runtime.Installed -ne 1) { throw \"$($specification.id): employer-owned Visual C++ x64 runtime is missing; ask IT, do not install a competing runtime.\" }\n}\n$args = @('install', '--id', $specification.id, '--exact', '--source', 'winget', '--scope', 'user', '--architecture', 'x64', '--silent', '--skip-dependencies', '--accept-package-agreements', '--accept-source-agreements', '--disable-interactivity')\nif ($specification.policy -eq 'exact') { $args += @('--version', $specification.version) }\nif ($specification.installerType) { $args += @('--installer-type', $specification.installerType) }\n& winget @args\nif ($LASTEXITCODE -ne 0) { throw \"Native command failed with exit code $LASTEXITCODE\" }\n# Portable Node's WinGet alias is node only. npm must use that same real ZIP directory.\nif ($specification.id -eq 'OpenJS.NodeJS.LTS') {\n  $node = Get-Item -LiteralPath (Get-ToolPath)\n  $realNode = if ($node.Target) { [string]$node.Target } else { $node.FullName }\n  $directory = Split-Path -Parent $realNode\n  if (-not (Test-Path -LiteralPath (Join-Path $directory 'npm.cmd'))) { throw 'Node user ZIP has no native npm.cmd alongside node.exe' }\n  $userPath = [Environment]::GetEnvironmentVariable('Path', 'User')\n  if ($directory -notin @($userPath -split ';')) { [Environment]::SetEnvironmentVariable('Path', ($userPath.TrimEnd(';') + ';' + $directory), 'User') }\n  $env:Path = $directory + ';' + $env:Path\n}\n"
      }
    },
    {
