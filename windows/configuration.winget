    {
      "name": "package tailnet",
      "type": "Microsoft.DSC.Transitional/WindowsPowerShellScript",
      "metadata": {
        "description": "Approved machine-scope Tailscale installer only; enrollment is explicit",
        "application": {
          "id": "Tailscale.Tailscale",
