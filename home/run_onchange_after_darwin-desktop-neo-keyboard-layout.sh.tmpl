{{- $host := index .hosts .host -}}
{{- $platform := index $host.platforms .chezmoi.os -}}
{{ if and (eq .chezmoi.os "darwin") $host.roles.desktop -}}
{{- $resources := include (joinPath .resourcesDir "manifest.json") | fromJson -}}
#!/bin/sh
set -eu
# resource/helper identity: {{ $resources.neo | toJson | sha256sum }}
neo-keyboard-layout-install {{ $resources.neo.source | quote }} {{ joinPath $platform.home "Library/Keyboard Layouts/neo-layouts.bundle" | quote }}
{{ end -}}
