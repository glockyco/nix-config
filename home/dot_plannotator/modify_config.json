{{- /* chezmoi:modify-template */ -}}
{{- /* Plannotator's settings page also writes this file, so only the sharing key is enforced. */ -}}
{{- $config := dict -}}
{{- if .chezmoi.stdin -}}{{- $config = fromJson .chezmoi.stdin -}}{{- end -}}
{{- $config = setValueAtPath "share" "disabled" $config -}}
{{- toPrettyJson $config }}
