{{- if and (eq .chezmoi.os "windows") (hasKey (index .hosts .host).platforms "windows") -}}
{{- $platform := index (index .hosts .host).platforms "windows" -}}
{{- $root := .chezmoi.sourceDir | dir -}}
{{- $inputs := list "windows/workstation.json" "windows/workstation.schema.json" "windows/Workstation.psm1" "windows/Workstation.Settings.ps1" "windows/Workstation.Delivery.ps1" "windows/Workstation.Validation.ps1" "windows/workstation.ps1" "windows/managed-applications.json" "windows/npm/package.json" "windows/npm/package-lock.json" -}}
#!/usr/bin/env pwsh
$ErrorActionPreference = 'Stop'
$PSNativeCommandUseErrorActionPreference = $false
Set-StrictMode -Version Latest
$expectedHashes = [ordered]@{
{{ range $path := $inputs -}}
  '{{ $path }}' = '{{ include (joinPath $root $path) | sha256sum }}'
{{ end -}}
}
$checkout = '{{ $platform.checkout | replace "'" "''" }}'
$sourceDirectory = '{{ .chezmoi.sourceDir | replace "'" "''" }}'
function ConvertTo-CheckoutPath([string]$Path) {
  [IO.Path]::GetFullPath($Path).Replace('\', '/').TrimEnd('/')
}
$rootOutput = @(& git -C $sourceDirectory rev-parse --show-toplevel)
if ($LASTEXITCODE -ne 0) { throw "git checkout-root discovery failed with exit code $LASTEXITCODE" }
if ($rootOutput.Count -ne 1) { throw 'Git must return exactly one checkout root' }
$gitRoot = ConvertTo-CheckoutPath ([string]$rootOutput[0])
if (-not $gitRoot.Equals((ConvertTo-CheckoutPath $checkout), [StringComparison]::OrdinalIgnoreCase)) {
  throw 'Git checkout root disagrees with hosts.korolev.platforms.windows.checkout'
}
if ($IsWindows -and ([IO.DriveInfo]::new([IO.Path]::GetPathRoot($gitRoot))).DriveType -ne [IO.DriveType]::Fixed) {
  throw 'The workstation checkout must use local fixed storage'
}
$rootMarker = Join-Path $gitRoot '.chezmoiroot'
if (-not (Test-Path -LiteralPath $rootMarker -PathType Leaf) -or [IO.File]::ReadAllText($rootMarker).Trim() -ne 'home') {
  throw 'Checkout .chezmoiroot must select home'
}
$effectiveSource = ConvertTo-CheckoutPath (Join-Path $gitRoot 'home')
if (-not $effectiveSource.Equals((ConvertTo-CheckoutPath $sourceDirectory), [StringComparison]::OrdinalIgnoreCase)) {
  throw 'Effective chezmoi source directory disagrees with the checkout .chezmoiroot'
}
foreach ($inputPath in $expectedHashes.Keys) {
  $path = Join-Path $gitRoot $inputPath
  if (-not (Test-Path -LiteralPath $path -PathType Leaf)) { throw "Workstation source is missing: $inputPath" }
  $actualHash = (Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash.ToLowerInvariant()
  if ($actualHash -cne $expectedHashes[$inputPath]) { throw "Workstation source changed after rendering: $inputPath. Render a fresh chezmoi diff before apply" }
}
# The engine rejects elevated execution before reading or changing user state.
& pwsh -NoLogo -NoProfile -NonInteractive -File (Join-Path $gitRoot 'windows/workstation.ps1') -Apply
if ($LASTEXITCODE -ne 0) { throw "workstation apply failed with exit code $LASTEXITCODE" }
{{ end -}}
