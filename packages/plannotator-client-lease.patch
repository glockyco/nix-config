index 0000000..f208451
--- /dev/null
+++ b/apps/hook/server/annotate-client-lease-cli.test.ts
@@ -0,0 +1,81 @@
+import { expect, test } from "bun:test";
+import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+
+const root = resolve(import.meta.dir, "../../..");
+const assetsBuilt = ["index.html", "review.html"].every((name) =>
+  existsSync(join(root, "apps/hook/dist", name)),
+);
+
+// The CLI imports built HTML. Run this regression after build:review and build:hook.
+// It catches gate-dependent capability wiring in the real dispatcher, not just the helper.
+// The child owns its clock, so parent fake timers cannot drive its production disconnect grace.
+test.skipIf(!assetsBuilt)("annotate --json without --gate exits dismissed after its browser disconnects", async () => {
+  const sandbox = mkdtempSync(join(tmpdir(), "plannotator-cli-lease-"));
+  const document = join(sandbox, "review snapshot.md");
+  const readyFile = join(sandbox, "ready.jsonl");
+  writeFileSync(document, "# Annotation-only review\n\nKeep this document unchanged.\n");
+
+  const child = Bun.spawn([process.execPath, join(root, "apps/hook/server/index.ts"), "annotate", document, "--json"], {
+    cwd: sandbox,
+    env: {
+      ...process.env,
+      HOME: sandbox,
+      PLANNOTATOR_DATA_DIR: join(sandbox, "data"),
+      PLANNOTATOR_CWD: sandbox,
+      PLANNOTATOR_REMOTE: "0",
+      PLANNOTATOR_PORT: "",
+      PLANNOTATOR_READY_FILE: readyFile,
+      PLANNOTATOR_SKIP_BROWSER_OPEN: "1",
+      PLANNOTATOR_AI: "disabled",
+      PLANNOTATOR_SHARE: "disabled",
+      PLANNOTATOR_ANNOTATE_HISTORY: "0",
+      PLANNOTATOR_FEEDBACK_HISTORY: "0",
+    },
+    stdin: "ignore",
+    stdout: "pipe",
+    stderr: "pipe",
+  });
+  const stdout = new Response(child.stdout).text();
+  const stderr = new Response(child.stderr).text();
+  const watchdog = setTimeout(() => child.kill(), 45_000);
+  const connection = new AbortController();
+
+  try {
+    const deadline = Date.now() + 15_000;
+    let readyRecord = "";
+    while (!readyRecord.endsWith("\n")) {
+      if (child.exitCode !== null) throw new Error(`CLI exited before readiness: ${await stderr}`);
+      if (Date.now() >= deadline) throw new Error("CLI did not become ready");
+      if (existsSync(readyFile)) readyRecord = readFileSync(readyFile, "utf8");
+      if (!readyRecord.endsWith("\n")) await Bun.sleep(20);
+    }
+    const ready = JSON.parse(readyRecord) as { url: string; isRemote: boolean };
+    expect(ready.isRemote).toBe(false);
+    const plan = await fetch(`${ready.url}/api/plan`).then((response) => response.json());
+    expect(plan.mode).toBe("annotate");
+    expect(plan.gate).toBe(false);
+    expect(plan.approvalNotesSupported).toBe(false);
+    expect(plan.clientLease).toEqual({ enabled: true, reconnectGraceMs: 30_000 });
+
+    const stream = await fetch(`${ready.url}/api/annotate/client-lease`, { signal: connection.signal });
+    expect(stream.status).toBe(200);
+    const reader = stream.body!.getReader();
+    expect((await reader.read()).done).toBe(false);
+    connection.abort();
+    await reader.cancel().catch(() => {});
+
+    expect(await child.exited).toBe(0);
+    const records = (await stdout).trim().split("\n").map((line) => JSON.parse(line));
+    expect(records).toEqual([{ decision: "dismissed" }]);
+    await expect(fetch(`${ready.url}/api/plan`)).rejects.toThrow();
+  } finally {
+    clearTimeout(watchdog);
+    connection.abort();
+    if (child.exitCode === null) child.kill();
+    await child.exited;
+    await Promise.all([stdout, stderr]);
+    rmSync(sandbox, { recursive: true, force: true });
+  }
+}, 50_000);
