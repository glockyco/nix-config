{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "$schema",
    "metadata",
    "resources"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json"
    },
    "metadata": {
      "type": "object",
      "required": [
        "winget"
      ],
      "properties": {
        "winget": {
          "type": "object",
          "required": [
            "processor"
          ],
          "properties": {
            "processor": {
              "type": "object",
              "required": [
                "identifier"
              ],
              "properties": {
                "identifier": {
                  "const": "dscv3"
                }
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "name",
          "properties"
        ],
        "properties": {
          "type": {
            "$ref": "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/definitions/resourceType.json"
          },
          "name": {
            "$ref": "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/definitions/instanceName.json"
          },
          "properties": {
            "type": "object"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "$ref": "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/definitions/instanceName.json"
            },
            "uniqueItems": true
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
